{
    "schemaVersion": 1,
    "id": "hhitmod",
    "version": "${version}",
    "name": "HHIT Mod",
    "description": "Client-side mod that hides or shows the held item tooltip.",
    "authors": ["Rick_doMasco"],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/RickdoMasco/hide-held-item-tooltip"
    },
    "license": "CC0-1.0",
    "icon": "assets/hhitmod/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": ["com.rickdomasco.hidehelditemtooltip.client.HHITModClient"]
    },
    "mixins": [
        {
            "config": "hhitmod.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~26.2",
        "java": ">=25",
        "fabric-api": "*"
    }
}
